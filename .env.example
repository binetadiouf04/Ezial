# Supabase — frontend-safe keys only.
# Copy this file to .env.local and fill in your real project values there.
# .env.local is git-ignored — never commit real values.
#
# Never put SUPABASE_SERVICE_ROLE_KEY here or anywhere in frontend code.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co (no trailing path)
VITE_SUPABASE_URL=

# Public anon/publishable key (safe for the browser — protected by RLS)
VITE_SUPABASE_ANON_KEY=
