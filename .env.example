# Supabase — frontend-safe keys only.
# Copy this file to .env.local and fill in your real project values there.
# .env.local is git-ignored — never commit real values.
#
# Never put SUPABASE_SERVICE_ROLE_KEY here or anywhere in frontend code.

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co (no trailing path)
VITE_SUPABASE_URL=

# Public anon/publishable key (safe for the browser — protected by RLS)
VITE_SUPABASE_ANON_KEY=

# Web Push VAPID public key only (safe for the browser). The matching
# private key is an Edge Function secret — never put it here.
VITE_VAPID_PUBLIC_KEY=

# Google Maps JavaScript API + Places API (New) key, restricted by HTTP
# referrer to the site's own domain in Google Cloud Console — safe for the
# browser only because of that restriction. The server-side key used for
# Routes API (GOOGLE_MAPS_SERVER_API_KEY) is a Supabase Edge Function
# secret, never a VITE_ variable — never put it here.
VITE_GOOGLE_MAPS_API_KEY=
